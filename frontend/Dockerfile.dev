FROM node:16-alpine

WORKDIR /app

# Copy package files
COPY package*.json ./

# Install dependencies from the lockfile so the container gets a stable,
# compatible dependency tree.
RUN npm ci

# Copy source code
COPY . .

# Expose port 8080
EXPOSE 8080

# Refresh dependencies on startup to repair any stale mounted node_modules volume.
CMD ["sh", "-c", "npm ci && npm run serve"]
